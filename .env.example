# VisionSentinel AI - example environment overrides
# ---------------------------------------------------------------------------
# These are the ONLY environment variables the application reads (see
# src/vision_sentinel/config.py and src/vision_sentinel/paths.py). Everything
# else lives in config/settings.yaml.
#
# The application reads the *process* environment. It does NOT load a .env file
# by itself (python-dotenv is intentionally not a dependency). Either export
# these in your shell, or set them in PowerShell before launching, for example:
#
#   $env:VS_DEVICE = "cpu"
#   streamlit run app.py
#
# Copy this file to .env only if you use a tool that loads it for you. Never
# commit real credentials; .env is git-ignored.

# --- Hardware / runtime ----------------------------------------------------

# Detection backend preference.
#   auto        Intel GPU when OpenVINO sees one, otherwise CPU (default).
#   intel       Force the OpenVINO Intel GPU backend.
#   cpu         Force the OpenVINO CPU backend.
#   nvidia_ort  Optional ONNX Runtime CUDA backend. Developer convenience ONLY;
#               it is NOT CraftifAI PipeGen and is NOT hackathon compliance.
#   pipegen     Read detections from a real CraftifAI PipeGen pipeline
#               (see evidence/pipegen/README.md). No fallback: it fails loudly
#               if the pipeline is not running.
# VS_DEVICE=auto

# Absolute or project-relative path to the ONNX model. Empty means
# <local app dir>/models/object_detection_yolox_2022nov.onnx.
# VS_MODEL_PATH=

# host:port of the detection sink published by the generated PipeGen pipeline.
# Required when VS_DEVICE=pipegen.
# VS_PIPEGEN_ENDPOINT=127.0.0.1:8554

# --- Video input -----------------------------------------------------------

# webcam | file | rtsp
# VS_SOURCE_TYPE=webcam

# Camera index for the webcam source (0 is usually the built-in camera).
# VS_CAMERA_INDEX=0

# Video file used when the source type is "file". Relative paths are resolved
# against the project root.
# VS_VIDEO_FILE=clips/front-door.mp4

# --- Storage ---------------------------------------------------------------

# Location of the SQLite incident database. Empty means
# <local app dir>/data/incidents.db.
# VS_DB_PATH=

# --- Where models, data and exports live -----------------------------------

# Base directory for the model, database, exports and snapshots. Empty means
# %LOCALAPPDATA%\VisionSentinelAI on Windows (kept out of cloud-synced folders
# such as OneDrive). Point this at a scratch volume if you prefer.
# VS_APP_DIR=
